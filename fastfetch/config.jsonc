{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "$HOME/.config/fastfetch/logo.txt",
        "color": { "1": "red" },
        "padding": {
            "top": 2,
            "left": 5,
            "right": 6
        }
    },
    "display": {
        "separator": " -> ",
        "color": { "keys": "red" }
    },
    "modules": [
        { "type": "title", "color": { "user": "red", "at": "white", "host": "red" } },
        "separator",
        { "type": "os", "key": "󰣇 ", "keyColor": "red" },
        { "type": "host", "key": "󰌢 ", "keyColor": "red" },
        { "type": "kernel", "key": "󰒋 ", "keyColor": "red" },
        { "type": "uptime", "key": "󰔛 ", "keyColor": "red" },
        "break",
        { "type": "board", "key": "󰆟 ", "keyColor": "red" },
        { "type": "cpu", "key": "󰻠 ", "keyColor": "red" },
        { "type": "gpu", "key": "󰢮 ", "keyColor": "red" },
        { "type": "memory", "key": "󰍛 ", "keyColor": "red" },
        { "type": "disk", "key": "󰋊 ", "keyColor": "red", "folders": "/home" },
        { "type": "display", "key": "󰍹 ", "keyColor": "red" },
        "break",
        { "type": "de", "key": "󰧨 ", "keyColor": "red" },
        { "type": "wm", "key": "󱂬 ", "keyColor": "red" },
        { "type": "shell", "key": "󱆃 ", "keyColor": "red" },
        { "type": "terminal", "key": "󰆍 ", "keyColor": "red" },
        { "type": "packages", "key": "󰏖 ", "keyColor": "red" },
        "break",
        "colors"
    ]
}
